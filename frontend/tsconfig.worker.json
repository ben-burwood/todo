{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["src/sw.ts"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ESNext", "WebWorker"],
    "types": ["vite-plugin-pwa/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
